# ---------------------------------------------------------------------------
# AI Accident Detection - environment variables
# Copy to `.env` for local development. NEVER commit the real `.env`.
# On Render, set these in the dashboard (Settings -> Environment).
# ---------------------------------------------------------------------------

# --- App / Flask ---
SECRET_KEY=change-me-to-a-long-random-string
# Max upload size (bytes). Keep at 16 MB on the free tier.
MAX_CONTENT_LENGTH=16777216

# --- YOLO inference (tuned for Render's 512 MB free tier) ---
# Images larger than this (longest edge) are downscaled before inference.
MAX_INFERENCE_IMAGE_DIM=1280
# Inference resolution (640 is the sweet spot for CPU + memory).
ROBUST_IMGSZ=640
# TTA and multi-scale multiply compute & memory; leave OFF on the free tier.
ROBUST_TTA=0
# Comma-separated extra scales, e.g. 1280. Leave EMPTY on the free tier.
ROBUST_MULTI_SCALE_SIZES=
# CLAHE contrast enhancement (cheap; safe to keep on).
ROBUST_ENHANCE=1
# Confidence thresholds (advanced tuning).
ROBUST_CONF=0.15
ROBUST_STANDARD_CONF=0.20
ROBUST_IOU=0.45

# --- Threads (must stay 1 on the 512 MB free tier) ---
OMP_NUM_THREADS=1

# --- Video / webcam tuning ---
# Process every Nth frame (2 = half the frames).
VIDEO_FRAME_SKIP=2
ACCIDENT_VIDEO_CONFIDENCE=0.65

# --- Camera ---
# 0 = primary webcam, or an IP stream URL like http://<ip>:<port>/video
CAMERA_SOURCE=0

# --- Severity classification ---
SEVERITY_MEDIUM_THRESHOLD=0.50
SEVERITY_HIGH_THRESHOLD=0.75

# --- Alerting (optional; leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
